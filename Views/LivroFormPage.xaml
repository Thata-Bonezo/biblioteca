<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MinhaBiblioteca.ViewModels"
             x:Class="MinhaBiblioteca.Views.LivroFormPage"
             x:DataType="vm:LivroFormViewModel"
             Title="{Binding TituloPage}"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="16">

            <!-- Card Principal do Formulário -->
            <Border Padding="20"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">
                
                <VerticalStackLayout Spacing="14">

                    <!-- Título do Livro -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Título do Livro *"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}">
                            <Entry Text="{Binding Titulo, Mode=TwoWay}"
                                   Placeholder="Ex: Dom Casmurro"
                                   PlaceholderColor="#94A3B8"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                   Margin="10,0" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Autor -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Autor *"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}">
                            <Entry Text="{Binding Autor, Mode=TwoWay}"
                                   Placeholder="Ex: Machado de Assis"
                                   PlaceholderColor="#94A3B8"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                   Margin="10,0" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Gênero -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Gênero Literário"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}">
                            <Entry Text="{Binding Genero, Mode=TwoWay}"
                                   Placeholder="Ex: Romance Clássico, Fantasia..."
                                   PlaceholderColor="#94A3B8"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                   Margin="10,0" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Grid de Páginas -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        
                        <!-- Total de Páginas -->
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Total de Páginas *"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                            <Border StrokeShape="RoundRectangle 10" StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}">
                                <Entry Text="{Binding TotalPaginas, Mode=TwoWay}"
                                       Keyboard="Numeric"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                       Margin="10,0" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Página Atual -->
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Página Atual"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                            <Border StrokeShape="RoundRectangle 10" StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}">
                                <Entry Text="{Binding PaginaAtual, Mode=TwoWay}"
                                       Keyboard="Numeric"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                       Margin="10,0" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Status Calculado -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Status da Leitura"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}">
                            <Picker ItemsSource="{Binding ListaStatus}"
                                    SelectedItem="{Binding Status, Mode=TwoWay}"
                                    TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                    Margin="10,0" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Nota (Estrelas) -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sua Avaliação (0 a 5)"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}">
                            <Entry Text="{Binding Nota, Mode=TwoWay}"
                                   Keyboard="Numeric"
                                   Placeholder="0 a 5"
                                   PlaceholderColor="#94A3B8"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                   Margin="10,0" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Resenha -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Resenha / Anotações"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}">
                            <Editor Text="{Binding Resenha, Mode=TwoWay}"
                                    Placeholder="Escreva suas impressões sobre o livro..."
                                    PlaceholderColor="#94A3B8"
                                    HeightRequest="90"
                                    TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                    Margin="10,4" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Botões de Ação -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,8,0,24">
                <Button Grid.Column="0"
                        Command="{Binding CancelarCommand}"
                        Text="Cancelar"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}"
                        BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                        CornerRadius="12"
                        HeightRequest="48" />

                <Button Grid.Column="1"
                        Command="{Binding SalvarCommand}"
                        Text="Salvar Livro"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="#4F46E5"
                        CornerRadius="12"
                        HeightRequest="48" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
